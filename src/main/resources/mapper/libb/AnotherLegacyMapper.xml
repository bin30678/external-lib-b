<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.external.libb.dao.AnotherLegacyDao">

    <!-- 外部 JAR B 自己的 MyBatis Mapper XML -->

    <select id="queryInactiveCustomerCount" resultType="int">
        SELECT COUNT(*) FROM customers WHERE status = 'INACTIVE'
    </select>

    <update id="updateCustomerStatus" parameterType="map">
        UPDATE customers SET status = #{newStatus} WHERE customer_name = #{customerName}
    </update>

</mapper>
